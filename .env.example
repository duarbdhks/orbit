# Orbit 환경 변수. 실제 값은 ~/Library/Application Support/Orbit/env/ 에 두고 Git에 넣지 않는다.

DATABASE_URL=postgres://orbit:change-me@orbit-pg:5432/orbit
PORT=8787

# Research API (/mcp, /decisions) bearer 토큰. 32자 이상.
ORBIT_API_TOKEN=
# /mcp 를 부를 수 있는 QM principal 과 그 사람의 Slack user id.
ORBIT_OWNER_PRINCIPAL=
ORBIT_OWNER_USER_ID=

# 수집기만 갖는 읽기 전용 Slack User OAuth 토큰.
SLACK_USER_TOKEN=
# 비어 있으면 수집하지 않는다. 채널 id 를 쉼표로 구분한다.
ORBIT_COLLECT_CHANNELS=
ORBIT_BACKFILL_DAYS=30
ORBIT_RETENTION_DAYS=180

# 실제 Slack 원문을 모델로 보낼지. false 면 샘플 채널만 나간다.
ORBIT_ANALYZE_REAL_DATA=false
ORBIT_ANALYZE_CHANNELS=

# 긴급 알림용 QM webhook. 비어 있으면 보내지 않는다.
ORBIT_QM_WEBHOOK_URL=
ORBIT_QM_WEBHOOK_SECRET=

# 실행 경로 라우터: off | shadow | active
ORBIT_ROUTER_MODE=shadow
# Jev 유료 호출. 켜고 예산을 0보다 크게 줘야만 OpenRouter 로 요청이 나간다.
ORBIT_JEV_ENABLED=false
ORBIT_JEV_DAILY_BUDGET_USD=0
OPENROUTER_API_KEY=
